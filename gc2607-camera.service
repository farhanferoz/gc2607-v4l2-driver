# Installed verbatim to /etc/systemd/system/ by gc2607-setup-service.sh (full setup) or
# `gc2607-setup-service.sh unit` (this file only). Paths are the fixed /opt/gc2607 install dir.
[Unit]
Description=GC2607 Camera Virtual Webcam
After=multi-user.target graphical.target
Wants=multi-user.target
# Stop the camera before system suspend/hibernate so the IPU6 can power down cleanly;
# the sleep hook (gc2607-resume) starts it again on resume. Conflicts= alone orders
# nothing (systemd.unit(5)), so without Before= the stop could still be running when
# sleep began - the -EBUSY case this exists to prevent. Added 2026-09-23.
Conflicts=sleep.target
Before=sleep.target

[Service]
Type=simple
ExecStart=/opt/gc2607/gc2607-service.sh
ExecStartPost=/opt/gc2607/gc2607-restart-wireplumber.sh
# on-failure, not on-abnormal: gc2607_isp exits 1 after repeated streaming failures so a
# fresh process can recover, and on-abnormal would leave that exit dead. A SIGTERM from
# sleep ends it with 0, which on-failure does not restart either.
Restart=on-failure
RestartSec=5
TimeoutStopSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
